{
  "name": "@lms/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "seed": "tsx src/db/seed.ts",
    "migrate": "tsx src/db/migrate.ts",
    "test": "node --test --import tsx test/*.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^9.3.0",
    "@fastify/cors": "^9.0.0",
    "@fastify/jwt": "^8.0.0",
    "@fastify/static": "^7.0.0",
    "@lms/shared": "workspace:*",
    "bcrypt": "^5.1.0",
    "better-sqlite3": "^13.0.0",
    "date-fns": "^3.6.0",
    "dotenv": "^16.4.0",
    "drizzle-orm": "^0.31.0",
    "fastify": "^4.27.0",
    "nanoid": "^5.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^20.12.0",
    "drizzle-kit": "^0.22.0",
    "tsx": "^4.10.0",
    "typescript": "^5.5.0"
  }
}
